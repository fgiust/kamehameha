{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/keep-alive", "schedule": "0 0 * * *" },
    { "path": "/api/keep-alive", "schedule": "0 4 * * *" },
    { "path": "/api/keep-alive", "schedule": "0 8 * * *" },
    { "path": "/api/keep-alive", "schedule": "0 12 * * *" },
    { "path": "/api/keep-alive", "schedule": "0 16 * * *" },
    { "path": "/api/keep-alive", "schedule": "0 20 * * *" }
  ]
}
